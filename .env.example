# ==========================================
# Configuración Docker Compose - Producción (Dokploy / VPS)
# Copie este archivo como .env y cambie TODOS los valores de ejemplo
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambie_esta_contrasena
POSTGRES_DB=transporte_db

PORT=3001

# Obligatorio. Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Dominios permitidos para CORS, separados por coma (vacío = mismo dominio vía Nginx)
CORS_ORIGINS=

# Almacenamiento local persistente en VPS
UPLOAD_DIR=/app/uploads
